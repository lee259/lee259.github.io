---
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = [
  {
    title: 'Agent Memory Management: A Layered Framework for Long-Term Context',
    slug: 'agent-memory-6-layer-framework',
    date: '2026-08-09',
    description: 'A practical framework for organizing what agents should remember, what they should forget, and when to update — answering what to keep, what to discard, and when to promote.',
    tags: ['AI Agent', 'Architecture', 'Developer Tools'],
  },
];
---

<BaseLayout title="Posts — Lee's Engineering Notes" description="All blog posts about AI agents, frontend engineering, and developer tools.">
  <section>
    <h1>All Posts</h1>
    <ul class="post-list" style="margin-top: 2rem;">
      {
        posts.sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime()).map(post => (
          <li class="post-item">
            <time datetime={post.date}>
              {new Date(post.date).toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric',
              })}
            </time>
            <h2><a href={`/posts/${post.slug}`}>{post.title}</a></h2>
            <p>{post.description}</p>
            <div class="tags">
              {post.tags.map(tag => <span class="tag">{tag}</span>)}
            </div>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
